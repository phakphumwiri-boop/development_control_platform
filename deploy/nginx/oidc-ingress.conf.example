# Reference Nginx ingress for the provider-neutral OIDC WSGI app.
# Replace dcp.example.invalid and certificate paths before deployment.
# WSGI must bind only to 127.0.0.1:8080; DCP_TRUSTED_PROXY_CIDRS=127.0.0.1/32.

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name dcp.example.invalid;
    return 308 https://dcp.example.invalid$request_uri;
}

# Reject unknown SNI/Host values at the TLS handshake.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    server_tokens off;
    return 444;
}

server {
    listen 443 ssl;
    server_name dcp.example.invalid;

    ssl_certificate     /etc/letsencrypt/live/dcp.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dcp.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # Only the OIDC auth routes reach the private WSGI listener.
    location ^~ /api/auth/oidc/ {
        limit_except GET POST { deny all; }
        client_max_body_size 8k;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8080;
        proxy_pass_request_headers off;
        proxy_pass_request_body on;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        proxy_redirect off;

        # Explicit allowlist: no inbound X-DCP-* or arbitrary forwarded headers.
        proxy_set_header Host dcp.example.invalid;
        proxy_set_header X-Forwarded-Host dcp.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-CSRF-Token $http_x_csrf_token;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Content-Length $content_length;
        proxy_set_header Accept $http_accept;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Referer $http_referer;
        proxy_set_header Connection "";
    }

    # Serve the same-origin SPA; point this at the reviewed UI build.
    root /srv/dcp-ui;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
